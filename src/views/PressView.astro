---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import Arrow from '../components/Arrow.astro';
import { t, typo, href, routes, gameRoute, type Locale } from '../i18n';
import { games } from '../data/games';
import { site } from '../data/site';

interface Props { locale: Locale }
const { locale } = Astro.props;
const s = t(locale);
const logoDir = '/press/oddly-official-games/';
const logos = [
  { ...s.press.logoItems[0], base: 'oddly-official-games-logo-for-dark-backgrounds' },
  { ...s.press.logoItems[1], base: 'oddly-official-games-logo-on-ink' },
  { ...s.press.logoItems[2], base: 'oddly-official-games-roundel' },
];
const mailto = `mailto:${site.email}?subject=${encodeURIComponent(s.contact.desks[1].subject)}`;
---
<Base locale={locale} title={s.press.metaTitle} description={s.press.metaDescription} paths={routes.press} current="press">
  <section class="page-head">
    <div class="wrap">
      <p class="label">{s.press.eyebrow}</p>
      <h1 class="display">{s.press.title}</h1>
      <p class="lead">{s.press.lead}</p>
      <p class="lead">{s.press.contactLine} <a class="link" href={mailto}>{site.email}</a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="studio-title">
    <div class="wrap">
      <SectionHead num="01" title={s.press.studioTitle} id="studio-title" />
      <div class="press-grid">
        <div class="prose">
          <h3 class="label">{s.press.shortLabel}</h3>
          <p class="first">{s.press.studioShort}</p>
          <h3 class="label">{s.press.longLabel}</h3>
          {s.press.studioLong.map((p) => <p>{p}</p>)}
        </div>
        <div>
          <h3 class="label" style="margin-bottom: 0.75rem">{s.press.factsTitle}</h3>
          <dl class="facts">
            {s.press.studioFacts.map((fact) => (
              <>
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </>
            ))}
            <dt>{s.nav.contact}</dt>
            <dd><a class="link" href={mailto}>{site.email}</a></dd>
          </dl>
        </div>
      </div>
    </div>
  </section>

  {games.map((game) => {
    const copy = typo(locale, game.copy[locale]);
    return (
      <section class="section section--alt" aria-labelledby={`press-${game.id}`}>
        <div class="wrap">
          <SectionHead num="02" title={`${s.press.gameTitle} · ${game.title}`} id={`press-${game.id}`} />
          <div class="press-grid">
            <div class="prose">
              <h3 class="label">{s.press.shortLabel}</h3>
              <p class="first">{copy.pressShort}</p>
              <h3 class="label">{s.press.longLabel}</h3>
              {copy.pressLong.map((p) => <p>{p}</p>)}
              <p><a class="btn btn--ghost" href={href(gameRoute(game.id)[locale])}>{s.common.openFile}<Arrow /></a></p>
            </div>
            <div>
              <h3 class="label" style="margin-bottom: 0.75rem">{s.press.factsTitle}</h3>
              <dl class="facts">
                {copy.facts.map((fact) => (
                  <>
                    <dt>{fact.label}</dt>
                    <dd>{fact.value}</dd>
                  </>
                ))}
                <dt>{s.game.storesLabel}</dt>
                <dd>
                  {game.stores.appStore || game.stores.googlePlay ? (
                    <>
                      {game.stores.appStore && <a class="link" href={game.stores.appStore} rel="noopener">{s.common.appStore}</a>}
                      {game.stores.appStore && game.stores.googlePlay && ' · '}
                      {game.stores.googlePlay && <a class="link" href={game.stores.googlePlay} rel="noopener">{s.common.googlePlay}</a>}
                    </>
                  ) : (
                    <>{s.common.appStore}, {s.common.googlePlay} · {s.common.notListed}</>
                  )}
                </dd>
                <dt>{s.game.privacyTitle}</dt>
                <dd><a class="link" href={game.privacyUrl} rel="noopener">{new URL(game.privacyUrl).host}<Arrow external /></a></dd>
              </dl>
            </div>
          </div>
        </div>
      </section>
    );
  })}

  <section class="section paper on-paper" aria-labelledby="assets-title">
    <div class="wrap">
      <SectionHead num="03" title={s.press.assetsTitle} id="assets-title" />
      <p class="section-lead">{s.press.assetsLead}</p>

      <h3 class="display sub">{s.press.logosTitle}</h3>
      <ul class="assets">
        {logos.map((logo) => (
          <li class="asset">
            <div class="thumb"><img src={href(`${logoDir}${logo.base}.svg`)} alt="" width="240" height="180" loading="lazy" /></div>
            <p class="name">{logo.name}</p>
            <p class="note">{logo.note}</p>
            <p class="files">
              <a class="file" href={href(`${logoDir}${logo.base}.svg`)} download ><span class="sr-only">{s.common.download} — {logo.name}, </span>SVG</a>
              <a class="file" href={href(`${logoDir}${logo.base}.png`)} download ><span class="sr-only">{s.common.download} — {logo.name}, </span>PNG</a>
            </p>
          </li>
        ))}
      </ul>

      {games.map((game) => {
        const copy = typo(locale, game.copy[locale]);
        return (
          <>
            <h3 class="display sub">{game.title} · {s.press.keyArtTitle}</h3>
            <ul class="assets">
              <li class="asset">
                <div class="thumb thumb--cover"><Picture src={game.keyArt} formats={['avif', 'webp']} widths={[320, 640]} sizes="15rem" alt={copy.portrait.alt} loading="lazy" /></div>
                <p class="name">{s.press.keyArtName}</p>
                <p class="note">{game.keyArt.width} × {game.keyArt.height} px</p>
                <p class="files"><a class="file" href={href(game.keyArtDownload)} download ><span class="sr-only">{s.common.download} — {s.press.keyArtName}, </span>PNG</a></p>
              </li>
            </ul>
            <h3 class="display sub">{game.title} · {s.press.screenshotsTitle}</h3>
            <p class="section-lead" style="margin-top: 0">{s.press.screenshotsNote}</p>
            <ul class="assets">
              {game.screenshots.map((shot, i) => (
                <li class="asset">
                  <div class="thumb thumb--cover thumb--tall"><Picture src={shot.image} formats={['avif', 'webp']} widths={[320, 600]} sizes="15rem" alt={shot.alt[locale]} loading="lazy" /></div>
                  <p class="name">{s.press.screenshot} {String(i + 1).padStart(2, '0')}</p>
                  <p class="files"><a class="file" href={href(shot.download)} download ><span class="sr-only">{s.common.download} — {s.press.screenshot} {i + 1}, </span>JPG</a></p>
                </li>
              ))}
            </ul>
          </>
        );
      })}
    </div>
  </section>

  <section class="section" aria-labelledby="missing-title">
    <div class="wrap">
      <SectionHead num="04" title={s.press.missingTitle} id="missing-title" />
      <p class="section-lead">{s.press.missingLead}</p>
      <ul class="missing">
        {s.press.missing.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>
</Base>
