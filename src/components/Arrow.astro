---
// Arrows are drawn, not typed: no dependency on a font having the glyph.
interface Props { external?: boolean }
const { external = false } = Astro.props;
---
{external ? (
  <svg class="ext" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M3 1.5h7.5V9M10.5 1.5 1.5 10.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square"></path></svg>
) : (
  <svg class="arrow" viewBox="0 0 18 12" aria-hidden="true" focusable="false"><path d="M0 6h16M11 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"></path></svg>
)}
