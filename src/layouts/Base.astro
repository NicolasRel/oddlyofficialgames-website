---
// Page shell: <head> (SEO, language versions, sharing), header, footer.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, href, absolute, otherLocale, type Locale } from '../i18n';
import { site } from '../data/site';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** This page's path in each language (from src/i18n/routes.mjs). */
  paths: { en: string; fr: string };
  current?: 'home' | 'games' | 'press' | 'contact' | 'legal';
  /** Sharing image, path under public/. Defaults to the studio card. */
  ogImage?: string;
  ogImageAlt?: string;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const { locale, title, description, paths, current, ogImage, ogImageAlt, jsonLd = [], noindex = false } = Astro.props;
const s = t(locale);
const other = otherLocale(locale);
const canonical = absolute(paths[locale], Astro.site);
const image = absolute(ogImage ?? `/og/studio-${locale}.png`, Astro.site);
// Pre-production builds must not be indexed: PUBLIC_NOINDEX=1 (see README, "Publishing").
const blockIndexing = noindex || import.meta.env.PUBLIC_NOINDEX === '1';
const csp = [
  "default-src 'self'",
  "script-src 'self'",
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data:",
  "font-src 'self'",
  'frame-src https://www.youtube-nocookie.com',
  "base-uri 'self'",
  "form-action 'none'",
  "object-src 'none'",
].join('; ');
---
<!doctype html>
<html lang={s.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {blockIndexing && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={absolute(paths.en, Astro.site)} />
    <link rel="alternate" hreflang="fr" href={absolute(paths.fr, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={absolute(paths.en, Astro.site)} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={s.ogLocale} />
    <meta property="og:locale:alternate" content={t(other).ogLocale} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt ?? `${site.name} — ${s.home.proposition}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#1C2027" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={href('/favicon-48.png')} type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <link rel="preload" href={href('/fonts/big-shoulders-display-900.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={href('/fonts/sofia-sans-500.woff2')} as="font" type="font/woff2" crossorigin />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip" href="#main">{s.nav.skip}</a>
    <Header locale={locale} paths={paths} current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} paths={paths} />
  </body>
</html>
